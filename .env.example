# ---- Server ----
PORT=8787

# ---- LLM provider ----
# "policy"    -> deterministic offline planner (no API key needed; used for CI + eval)
# "anthropic" -> Claude tool-use agent (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=policy
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Simulation / business rules ----
# Fixed "today" so mock data and evals are deterministic
SIM_DATE=2026-10-14
# POs above this value are never auto-executed: they wait for a human approval
AUTO_APPROVE_LIMIT_USD=5000
# Review period (days between replenishment runs) used for cover calculation
REVIEW_PERIOD_DAYS=7
# Safety-stock z-score (1.65 ~ 95% service level)
SERVICE_LEVEL_Z=1.65
# Cover beyond (target cover x this factor) is flagged as excess
EXCESS_COVER_FACTOR=1.5

# ---- Agent guardrails ----
MAX_AGENT_STEPS=30
